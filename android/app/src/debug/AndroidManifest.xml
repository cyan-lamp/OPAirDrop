<?xml version="1.0" encoding="utf-8"?>
<!--
  debug 源集：只为真机试验准备，release 包不会带上这里声明的任何组件。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!--
          从「后台」发一张卡。必须有它才能测「通知到达时胶囊会不会自动展开」：应用自己在前台
          时系统会抑制那颗胶囊，而从 Activity 里发通知就一定会把应用带到前台，测不出结果。
        -->
        <receiver
            android:name=".LiveProbe"
            android:exported="true">
            <intent-filter>
                <action android:name="com.oshare.airdrop.PROBE" />
            </intent-filter>
        </receiver>

        <!--
          不给广播的那条路。应用被 ColorOS 冻住时广播会被无限期挂起（详见 LiveProbeActivity
          的注释），Activity 不会：它一定能起来，也一定能把进程解冻。NoDisplay + onCreate 里
          就 finish()，屏幕上什么都不显示。
        -->
        <activity
            android:name=".LiveProbeActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay" />
    </application>
</manifest>
