<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The platform's own Material theme, not a library's: this app has no dependency
         beyond the Android SDK, and the settings page is built from widgets, so a theme
         library would be a second set of defaults to fight.

         NoActionBar because both pages draw their own heading. With an action bar the status
         page showed "OPAirDrop" twice — once in a black strip and once as the title it draws
         itself — and the strip also pushed the real content down by its own height. -->
    <style name="AppTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorAccent">#2563EB</item>
        <!-- The page colour, and the same value as MainActivity.BG: the floating nav pill's
             glass is filled with it, and a glass that is not the page colour reads as a
             bright square instead of a pane floating over the same sheet of paper. -->
        <item name="android:windowBackground">#F0F1F3</item>
        <!-- Without the action bar the top of the window is the status bar itself, so its
             icons have to be dark: the light default is white on a #FFFBFE background. -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>

        <!-- Cold start, taken over unchanged from the legacy app except for the direction of
             the drawing: the centre dot appears first and the two rings open outwards from it
             (0 / 110 / 230 ms in res/animator/). Same artwork, same background, same
             1000 ms window.

             The dark variant lives in values-night/themes.xml and repeats every item here:
             a style is selected whole, never merged item by item, so a night style that only
             listed the differing lines would silently drop the rest. -->
        <item name="android:windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon_anim</item>
        <item name="android:windowSplashScreenAnimationDuration">1000</item>
    </style>

    <!-- 发送面板：一块从底边上滑的玻璃，不是一个新建的页面。

         windowIsTranslucent + 透明窗口背景，是为了让 Window.setBackgroundBlurRadius
         有东西可模糊：系统模糊的是**这个窗口后面**的那个窗口，而窗口背景不透明时它模糊的
         只是自己，什么也看不见。分享面板还开在下面时，透出来的就是它。

         整套窗口动画都换成 0 时长（@anim/none）：面板自己负责上滑与下滑，平台再叠一层
         淡入或缩放，读起来就是两段互不相干的移动同时发生。

         backgroundDimEnabled=false 同理：压暗一层会把模糊让位给一块灰板，读起来像系统
         弹了个对话框，而不是这个应用浮在自己那一层上。 -->
    <style name="SendPanelTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@style/PanelAnimation</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <style name="PanelAnimation">
        <item name="android:activityOpenEnterAnimation">@anim/none</item>
        <item name="android:activityOpenExitAnimation">@anim/none</item>
        <item name="android:activityCloseEnterAnimation">@anim/none</item>
        <item name="android:activityCloseExitAnimation">@anim/none</item>
    </style>
</resources>
