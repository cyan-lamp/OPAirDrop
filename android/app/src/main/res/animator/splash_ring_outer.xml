<?xml version="1.0" encoding="utf-8"?>
<!-- 最后一拍：外环的揭示。内环起跑 250 ms 后跟上（500 起、400 长），揭示窗（outerClip）
     的上沿从环的底缘（y=78）收到 -20——露出的部分从底弧开始，左右两半同时向上生长，
     最外面这一圈总是最后站出来，视线被送到边缘，正好接上界面出现。

     pathData 同样是「矩形到矩形」的同构 morph。2026-11-25 改版：缩放撤掉，
     三样从一开始就站在最终位置上（见 splash_icon.xml 的改版注释）。

     500 + 400 = 900 ms，落在 theme 里 windowSplashScreenAnimationDuration
     的 1000 ms 之内：系统给的这段窗口只够画完，不够重来一次。 -->
<objectAnimator xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="400"
    android:startOffset="500"
    android:interpolator="@android:interpolator/decelerate_cubic">
    <propertyValuesHolder
        android:propertyName="pathData"
        android:valueFrom="M -20,78 L 128,78 L 128,128 L -20,128 Z"
        android:valueTo="M -20,-20 L 128,-20 L 128,128 L -20,128 Z" />
</objectAnimator>
