<?xml version="1.0" encoding="utf-8"?>
<!-- Splash-screen icon: the launcher artwork (center blue dot + two 5/6 open
     rings). Each ring sits inside a group with its own clip rectangle, and the
     clip is what the cold-start animation drives: a horizontal cut that starts
     at the ring's bottom edge and sweeps up to reveal the whole shape, so both
     halves grow upward at once ("左右对称由下往上").

     2026-11-25 改版：原来的动画是缩放（三样从 0/0.55 长到 1），启动的头几百毫秒
     里内圈外圈叠在中心——用户要求三样从一开始就站在最终位置上，动画只做「揭示」。
     同样的几何与渐变与 ic_launcher_foreground.xml。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 内环的揭示窗：起点在环的底缘（y=70 只露底弧），动画里上沿收到 -20（全露）。 -->
    <group
        android:name="innerReveal"
        android:pivotX="54"
        android:pivotY="54">
        <clip-path
            android:name="innerClip"
            android:pathData="M -20,70 L 128,70 L 128,128 L -20,128 Z" />
        <group
            android:name="ringInner"
            android:pivotX="54"
            android:pivotY="54">
            <path android:pathData="
                M46.63,66.77 A14.75,14.75 0 1 1 61.38,66.77
                L58.63,62.01 A9.25,9.25 0 1 0 49.38,62.01 Z
                M45.25,64.39 a2.75,2.75 0 1 0 5.5,0 a2.75,2.75 0 1 0 -5.5,0 Z
                M57.25,64.39 a2.75,2.75 0 1 0 5.5,0 a2.75,2.75 0 1 0 -5.5,0 Z">
                <aapt:attr name="android:fillColor" xmlns:aapt="http://schemas.android.com/aapt">
                    <gradient
                        android:type="linear"
                        android:startX="30" android:startY="26"
                        android:endX="78" android:endY="82"
                        android:startColor="#FF47A3F8"
                        android:endColor="#FF1B5CF0" />
                </aapt:attr>
            </path>
        </group>
    </group>

    <!-- 外环的揭示窗：底缘 y≈74，起点切线在 y=78。 -->
    <group
        android:name="outerReveal"
        android:pivotX="54"
        android:pivotY="54">
        <clip-path
            android:name="outerClip"
            android:pathData="M -20,78 L 128,78 L 128,128 L -20,128 Z" />
        <group
            android:name="ringOuter"
            android:pivotX="54"
            android:pivotY="54">
            <path android:pathData="
                M42.5,73.92 A23,23 0 1 1 65.5,73.92
                L62.75,69.16 A17.5,17.5 0 1 0 45.25,69.16 Z
                M41.13,71.54 a2.75,2.75 0 1 0 5.5,0 a2.75,2.75 0 1 0 -5.5,0 Z
                M61.38,71.54 a2.75,2.75 0 1 0 5.5,0 a2.75,2.75 0 1 0 -5.5,0 Z">
                <aapt:attr name="android:fillColor" xmlns:aapt="http://schemas.android.com/aapt">
                    <gradient
                        android:type="linear"
                        android:startX="30" android:startY="26"
                        android:endX="78" android:endY="82"
                        android:startColor="#FF47A3F8"
                        android:endColor="#FF1B5CF0" />
                </aapt:attr>
            </path>
        </group>
    </group>

    <group
        android:name="dot"
        android:pivotX="54"
        android:pivotY="54">
        <path android:pathData="M47.5,54 a6.5,6.5 0 1 0 13,0 a6.5,6.5 0 1 0 -13,0 Z">
            <aapt:attr name="android:fillColor" xmlns:aapt="http://schemas.android.com/aapt">
                <gradient
                    android:type="linear"
                    android:startX="30" android:startY="26"
                    android:endX="78" android:endY="82"
                    android:startColor="#FF47A3F8"
                    android:endColor="#FF1B5CF0" />
            </aapt:attr>
        </path>
    </group>
</vector>
