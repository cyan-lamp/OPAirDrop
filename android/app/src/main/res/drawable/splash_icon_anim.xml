<?xml version="1.0" encoding="utf-8"?>
<!-- 冷启动的启动图标：中心点淡入，内环、外环各自从底缘向上揭示（左右两半同时生长），
     最后停在静态图标那一帧上。

     2026-11-25 改版：三样从一开始就站在最终位置上（缩放动画撤掉），动画改由揭示窗
     驱动——target 的 name 从环组改成了各自的 clip-path（innerClip / outerClip），
     见 splash_icon.xml 里的改版注释与 animator 文件。

     顺序不靠 target 的书写次序，靠各自 animator 里的 startOffset（dot 0 / 内环 250 /
     外环 500 ms）。没有环绕、没有循环：动画的最后一帧（揭示窗全开）必须与静态启动
     图标一模一样，否则系统撤掉 splash 的那一刻会看到图形跳一下。 -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/splash_icon">
    <target
        android:name="outerClip"
        android:animation="@animator/splash_ring_outer" />
    <target
        android:name="innerClip"
        android:animation="@animator/splash_ring_inner" />
    <target
        android:name="dot"
        android:animation="@animator/splash_dot" />
</animated-vector>
