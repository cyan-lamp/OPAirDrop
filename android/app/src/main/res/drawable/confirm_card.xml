<?xml version="1.0" encoding="utf-8"?>
<!-- 悬浮卡片的底：圆角 + 一层极轻的描边，深浅两套都由 @color/confirm_card 决定。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/confirm_card" />
    <corners android:radius="28dp" />
    <stroke
        android:width="1dp"
        android:color="@color/confirm_stroke" />
</shape>
