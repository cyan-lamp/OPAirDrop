<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The receive endpoint binds a socket and answers HTTP on it, so this is the one
         permission the receiver needs. The legacy manifest's service and link permissions
         stay undeclared: nothing here touches the device's own AirDrop plumbing, and a
         permission declared for code that does not exist reads as a feature that does. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 底栏三格按下时那声「一下」。没有这条权限，Vibrator.vibrate 会抛 SecurityException，
         而调用点是故意吞掉异常的（触感失败不该让切页失败），于是表现为「完全没有震动」——
         看起来像代码没写，其实是没声明。 -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Finding peers is a multicast subscription: without this the socket receives nothing
         once the screen dims, because the platform treats an app with no multicast lock as
         one that does not need the packets. It is normal-level and needs no prompt. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- 叫醒 iPhone 用的那条 AirDrop 广播。发现**不是**从 mDNS 开始的：iPhone 要先在蓝牙
         上听到一条 AirDrop 广播，才会把 AWDL 上的 AirDrop 服务拉起来。少了这一层，空口上
         会出现「对端在场、8770 端口没人听」的样子——查询每两秒发一次、每帧都合法、都上了
         无线，回包一个也没有。
         ADVERTISE 在 API 31+ 是运行时权限，发送页自己会申请；CONNECT 是读适配器状态
         （这枚芯片够不够格做多路广播、蓝牙开没开）时要用的，缺了它那几个 getter 是抛
         SecurityException 而不是返回 false。 -->
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- 没有 BLE 的机器装得上、只是叫不醒对端；用 required="false" 而不是让安装被拦下。 -->
    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="false" />

    <!-- Receiving has to outlive the window: without a foreground service ColorOS stops a
         background process about ninety seconds after the last activity closes, and a phone
         lying on a desk is exactly when a transfer is expected to arrive. Type
         connectedDevice (not dataSync) because talking to a foreign device is the whole job
         and dataSync carries a time limit this feature would collide with. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- The notification is not a message to the user, it is the receipt a foreground
         service has to show. Without the permission the service still runs; the notice is
         simply not drawn. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 实时通知（状态栏那颗胶囊，ColorOS 把它画在流体云的位置）。
         这条权限不是「多发一条通知」：它决定我们的进度通知能不能被系统提升到那个位置。
         Android 16 起这是一条独立权限，没声明时对应的 AppOp 永远是 ignore——
         2026-11-16 实测：`cmd appops get` 显示 `POST_PROMOTED_NOTIFICATIONS: ignore`，
         而且无论怎么 `appops set allow` 都改不动，因为那条 AppOp 是跟着这条权限走的。 -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />

    <!-- 「允许后台运行」。这一条不是运行时权限，它是一枚**能自己弹框的凭证**：电池优化白名单
         只有系统能改，而 Settings.ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS 那个确认框要求
         发起方持有本条权限。不声明它，startActivity 抛 SecurityException，人看到的是「点了没
         反应」——比不弹框更糟，因为它看起来像我们写了但没生效。
         
         为什么非进这个名单不可：2026-11-17 实测，ColorOS 的 nwpower 在应用一离开前台就打印
         `Close socket:[10456] cause:App bg(IMMEDIATELY)`，同一毫秒抓包里是本机发出的 RST。
         于是 iPhone 点发送、邀请正常弹出、人点接收——那一刻 socket 已经断了 3.4 秒，客户端
         只拿到 Software caused connection abort，界面表现为「流体云通知自己关了」。
         把本应用写进 deviceidle 白名单之后，同样的动作两次都完整跑完了（0% → 100% →
         `接收完成 · 2 份 · 2.9 MiB`）。
         
         前台服务挡不住这一层：出事那次 dumpsys 里服务明确标着 fg-service，它照掐。 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".App"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 发送页，也是本应用在系统分享面板里的入口。
             type 写 */* 是故意的：分享什么都要能接，具体能不能发由发送页判断——
             拒绝一份 PDF 的理由，只有拿到文件之后才知道。singleTop 是为了第二次分享
             替换掉第一次的文件，而不是叠出第二个窗口。 -->
        <activity
            android:name=".SendActivity"
            android:exported="true"
            android:label="@string/send_title"
            android:launchMode="singleTop"
            android:theme="@style/SendPanelTheme"
            android:excludeFromRecents="true"
            android:resizeableActivity="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!-- 控制中心的【AirDrop】磁贴。
             BIND_QUICK_SETTINGS_TILE 是系统绑定它的门槛：只有 SystemUI 拿得到，别的应用绑不上。
             导出是必须的——系统要从自己那个进程里找到它。 -->
        <service
            android:name=".AirdropTile"
            android:exported="true"
            android:icon="@drawable/tile_airdrop"
            android:label="@string/tile_airdrop"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- 【打开文件】的落点：先撤卡，再按类型打开相册或文件管理。

             这里必须是 activity 而不是 receiver。通知点下去的 PendingIntent 只允许落到界面上，
             落到广播再由广播起界面会被平台当成「后台启动」拦掉（Android 12 起禁止通知蹦床，
             2026-11-16 实测 result code=102 BAL_BLOCK，相册没打开、也没有提示）。

             窗口全透明、不进最近任务、不参与任务栈：它只是那一下点击的落脚处，撤完卡就把人交给
             相册，自己立刻消失。 -->
        <activity
            android:name=".OpenDownload"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:noHistory="true" />

        <!-- 「完成」按钮的落点：撤掉那张卡。不导出——只有本应用的通知会带这条 PendingIntent。 -->
        <receiver
            android:name=".CardDismiss"
            android:exported="false" />

        <!-- Reachable only from the settings page, so not exported: there is nothing a
             settings page does that another app should be able to trigger. -->
        <activity
            android:name=".AboutActivity"
            android:exported="false"
            android:label="@string/about_title"
            android:parentActivityName=".MainActivity" />

        <!-- The licence full text, opened from the about page. Not exported for the same
             reason as AboutActivity: nothing outside this app should be able to push a page
             in front of the user. parentActivityName points at AboutActivity, not at the
             main window, so the system's "up" lands where the person came from. -->
        <activity
            android:name=".LicenseActivity"
            android:exported="false"
            android:label="@string/license_title"
            android:parentActivityName=".AboutActivity" />

        <!-- The receiver's foreground identity: started when something says we should be
             listening (the control-centre window, or OShare's own everyone mode) and stopped
             when nothing does. stopWithTask=false so closing the window does not cut a
             transfer that is arriving. -->
        <service
            android:name=".ReceiveService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice"
            android:stopWithTask="false" />

        <!-- The two buttons on the "somebody wants to send you files" notification. Not
             exported: a PendingIntent carries this app's identity, so the notification can
             reach it while no other app can forge an "accept". -->
        <receiver
            android:name=".DecisionReceiver"
            android:exported="false" />

    </application>
</manifest>
