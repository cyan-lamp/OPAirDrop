<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- The receiver has to outlive the activity and survive the background: without a
         foreground service ColorOS stops it with "Stopping service due to app idle"
         about ninety seconds after the window closes, and a phone on a desk is exactly
         when a transfer is expected to arrive. Type connectedDevice (not dataSync)
         because foreign devices are the whole point and dataSync carries a time limit. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- connectedDevice requires one of a fixed set of companion permissions at runtime;
         these two are normal-level and are things this app genuinely does. -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Bluetooth LE advertising: the wake-up signal, not a transport.
         An iPhone in Everyone mode does not bring its AirDrop server up on awdl0
         until it hears one of these, which is why every other layer can be correct
         while the phone's port 8770 answers nothing but RST. Both permissions are
         runtime-dangerous on API 31+, so declaring them here is only half the job;
         BleWake.checkSelfPermission is the other half.

         SCAN is deliberately absent: this app advertises so that receivers wake, it
         never scans for other advertisers, and asking for a permission we do not use
         costs the user a dialog and buys nothing. -->
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <!-- CONNECT is not for connecting either: it is what guards the adapter queries
         BleWake has to make before advertising. isEnabled and
         isMultipleAdvertisementSupported both want it on API 31+. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Advertising is the entry point of the whole protocol, so a device without LE
         cannot do the job; it is declared optional only because a hard requirement
         hides the app from a store listing where it is still useful as a receiver. -->
    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="false" />


    <queries>
        <package android:name="com.google.android.mosey" />
        <package android:name="com.coloros.oshare" />
        <package android:name="org.lsposed.manager" />
        <package android:name="me.weishu.kernelsu" />
        <package android:name="com.rifsxd.ksunext" />
        <package android:name="com.sukisu.ultra" />
        <package android:name="me.bmax.apatch" />
        <package android:name="com.topjohnwu.magisk" />
        <package android:name="io.github.huskydg.magisk" />
    </queries>

    <application
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/AppTheme">

        <!-- orientation unlocked (landscape supported); configChanges keeps
             the activity alive across rotation AND day/night flips so tab/
             scroll state and the probed environment survive without
             recreation — uiMode changes are re-themed in place instead -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The share target. This is what puts OPAirDrop in the system share sheet
             where Quick Share used to be, and it is why the wildcard type is claimed:
             a share of anything is meant to be answerable here, and the sender decides
             what it has. singleTop so a second share from the same app replaces the
             files in the window instead of stacking another copy of it; uiMode in
             configChanges so a day/night flip mid-transfer does not destroy the
             activity and cut the socket with it. -->
        <activity
            android:name=".SendActivity"
            android:exported="true"
            android:label="@string/send_title"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!-- Mosey-free AirDrop endpoint: identity + mDNS + TLS on the wonder0 link.
             Started from the activity; survives it so a transfer can arrive while
             the share sheet has focus, and runs in the foreground so the system does
             not reap it once the app is idle. -->
        <service
            android:name=".AirDropRuntime"
            android:exported="false"
            android:foregroundServiceType="connectedDevice"
            android:stopWithTask="false" />

        <!-- adb-only gate for the BLE wake-up broadcast, so the trigger can be
             measured in isolation before it is wired into the send path. Send the
             action below with the string extra "op" set to start, status or stop;
             the exact command lines are in the class javadoc of BleWakeReceiver.
             Guarded by DUMP rather than left open: shell and system hold it, ordinary
             apps do not, and a stray advertisement is visible to every phone in the
             room under our tag. `am broadcast` prints the result data, so the reply
             carries the reason when it could not start. -->
        <receiver
            android:name=".BleWakeReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.oshare.airdrop.BLE_WAKE" />
            </intent-filter>
        </receiver>

        <!-- LSPosed delivers its service binder here (libxposed service
             handshake); authority must be <pkg>.XposedService -->
        <provider
            android:name=".XposedServiceGate"
            android:authorities="com.oshare.airdrop.XposedService"
            android:directBootAware="true"
            android:exported="true" />
    </application>
</manifest>
