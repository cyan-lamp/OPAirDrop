# 构建产物
target/
android/.gradle/
android/build/
android/app/build/
fuzz/target
fuzz/corpus
fuzz/artifacts
fuzz/coverage

# 本机配置：SDK 位置与签名口令，每台机器自己写，不进仓库
android/local.properties
android/keystore.properties
*.jks
*.keystore

# 临时文件、日志与 Python 缓存
.tmp/
*.log
__pycache__/
*.pyc

# 抓包：能回答的问题都已折算成文档里的数字，读包的脚本留在 tools/ 里
*.pcap

# 模块载荷的实验副本：跑过哪一份由 sha256 与 kernel/README.md 记录，
# 随包发布的 *.ko.gz 不带后缀，照常入库
kernel/*.ko.gz.*

# Plan.md 是开发机上的任务书，随工作进度持续改写，不入库、不推送。
Plan.md
